#!/bin/bash
set -e
modprobe vhci_hcd

REMOTE_IP="{{ remote_ip }}"
BUS_ID_ZIGBEE="{{ bus_id_zigbee }}"
DEVICE_PATH="/dev/serial/by-id/usb-dresden_elektronik_ingenieurtechnik_GmbH_ConBee_II_{{ conbee_serial }}-if00"

# Local file check, not `usbip port` (a network call) -- this runs on a
# timer to self-heal dropped connections, and repeatedly querying usbip
# over the network was itself observed to cause disconnects.
# Must be a symlink specifically (what udev creates) -- a plain directory
# at this path means Docker auto-created it for a bind mount whose source
# didn't exist yet, not that the device is actually attached.
# The device being attached doesn't mean HA is running -- the container can
# die (OOM, manual stop, failed restart) independently of the USB/IP link,
# and this timer is the only thing checking either, so it must check both.
if [ -L "$DEVICE_PATH" ]; then
    if [ "$(docker inspect -f '{{ "{{" }}.State.Running{{ "}}" }}' homeassistant 2>/dev/null)" != "true" ]; then
        echo "Device attached but homeassistant container is not running -- starting it."
        docker start homeassistant
    fi
    exit 0
fi
if [ -d "$DEVICE_PATH" ]; then
    rmdir "$DEVICE_PATH"
fi

echo "Attempting to attach USB/IP device $BUS_ID_ZIGBEE from $REMOTE_IP"
if usbip attach -r "$REMOTE_IP" -b "$BUS_ID_ZIGBEE"; then
    echo "USB/IP device $BUS_ID_ZIGBEE attached successfully."
else
    echo "USB/IP attach failed for $BUS_ID_ZIGBEE. Attempting to rebind..."
    # unbind legitimately fails (device not bound) when the device was never
    # bound in the first place, not just when it's stuck -- don't let that
    # abort the script before the bind (the actual fix) gets a chance to run.
    ssh -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 user@"$REMOTE_IP" sudo /usr/sbin/usbip unbind --busid="$BUS_ID_ZIGBEE" || true
    ssh -o StrictHostKeyChecking=accept-new -o ConnectTimeout=5 user@"$REMOTE_IP" sudo /usr/sbin/usbip bind --busid="$BUS_ID_ZIGBEE"
    usbip attach -r "$REMOTE_IP" -b "$BUS_ID_ZIGBEE"
fi

# Only reached when we actually just (re)attached -- restart homeassistant
# so it picks up the device. udevadm settle alone isn't enough -- observed
# the symlink still not resolving right after it returns, which makes
# `docker restart` fail its start half (device node missing) after it's
# already killed the old container. Poll for the resolved path directly.
udevadm settle
for i in $(seq 1 10); do
    if readlink -f "$DEVICE_PATH" >/dev/null 2>&1; then
        break
    fi
    sleep 0.5
done
docker restart homeassistant || true
